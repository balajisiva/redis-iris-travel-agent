# OpenAI LLM key used by LangGraph / langchain-openai.
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=http://100.73.53.47:8000/v1

# Redis Agent Memory service configuration.
AGENT_MEMORY_SERVER_URL=https://your-agent-memory-service.example.com
AGENT_MEMORY_STORE_ID=your-store-id
AGENT_MEMORY_API_KEY=your-agent-memory-api-key

# Redis LangCache service configuration.
LANGCACHE_SERVER_URL=https://aws-us-east-1.langcache.redis.io
LANGCACHE_CACHE_ID=your-cache-id
LANGCACHE_API_KEY=your-langcache-api-key
LANGCACHE_DISTANCE_THRESHOLD=0.2

# PostgreSQL database (for RDI simulation).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=traveldb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cloud connection (for RDI simulation and Context Retriever).
REDIS_HOST=your-redis-cloud-host.redis.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true

# Redis Context Retriever service.
CONTEXT_RETRIEVER_URL=https://your-context-retriever.redis.io
CONTEXT_RETRIEVER_API_KEY=your-context-retriever-api-key

# Optional demo tuning.
OPENAI_MODEL=gpt-4.1-mini
DEMO_OWNER_ID=alice
DEMO_NAMESPACE=langgraph-travel-demo
DEMO_AGENT_ID=travel-agent

